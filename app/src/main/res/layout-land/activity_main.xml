<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_app_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHeaderVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 横屏双栏主体 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- 左栏：控制与配置区 -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.08"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="4dp">

                <!-- 卡片1：顶部状态与快速操作 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="运行状态与快速控制"
                        android:textColor="@color/accent_ocean"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvServiceStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="监控服务状态：检查中..."
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvEvaluatedMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="当前判定模式：等待评估..."
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvLiveWallpaperStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="动态壁纸服务：检查中..."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvLastApplyResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="最近应用状态：尚未切换"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnToggleService"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_primary"
                            android:text="@string/btn_start_service"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnActivateLiveWallpaper"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_secondary"
                            android:text="@string/btn_activate_live_wallpaper"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnManualLight"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_light"
                            android:text="@string/btn_manual_light"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnManualDark"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_dark"
                            android:text="@string/btn_manual_dark"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 卡片2：壁纸预览与选图 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="日间 / 夜间壁纸设置与预览"
                        android:textColor="@color/accent_ocean"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- 日间预览 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/ivPreviewLight"
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                android:background="@drawable/bg_console"
                                android:contentDescription="日间亮色壁纸预览"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:id="@+id/tvLightMeta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="日间壁纸"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/btnPickLight"
                                android:layout_width="match_parent"
                                android:layout_height="38dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_btn_secondary"
                                android:text="@string/btn_pick_light"
                                android:textAllCaps="false"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- 夜间预览 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/ivPreviewDark"
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                android:background="@drawable/bg_console"
                                android:contentDescription="夜间暗色壁纸预览"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:id="@+id/tvDarkMeta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="夜间壁纸"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/btnPickDark"
                                android:layout_width="match_parent"
                                android:layout_height="38dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_btn_secondary"
                                android:text="@string/btn_pick_dark"
                                android:textAllCaps="false"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnResetWallpapers"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:text="@string/btn_reset_wallpapers"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 卡片3：壁纸实现模式选择（双模式兼容） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="壁纸切换实现模式（双模式兼容）"
                        android:textColor="@color/accent_ocean"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgWallpaperMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbModeDual"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="双模式同时生效（动态壁纸引擎 + 静态 WallpaperManager，推荐）"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbModeLive"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="仅动态壁纸服务（WallpaperService 内存渐变绘制）"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbModeStatic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="仅静态壁纸替换（WallpaperManager.setBitmap）"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </RadioGroup>

                    <CheckBox
                        android:id="@+id/cbStaticSyncLockScreen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="静态替换时同步更新锁屏壁纸 (FLAG_LOCK)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 卡片4：触发条件与阈值配置 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="亮/暗触发条件与策略"
                        android:textColor="@color/accent_ocean"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgTriggerSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbTriggerSystem"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="跟随车机系统深浅色模式 (Configuration.uiMode)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbTriggerLight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="跟随比亚迪车灯开关 (BYDAutoLightDevice)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbTriggerSensor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="跟随比亚迪环境光感等级 (BYDAutoSensorDevice)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbTriggerAnyDark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="多源联合触发（任一已连接信号判定为暗色即切换）"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="车灯触发细项（开启即视为夜间）："
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/cbLightSide"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="示宽/小灯"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <CheckBox
                            android:id="@+id/cbLightLowBeam"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="近光灯"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <CheckBox
                            android:id="@+id/cbLightHighBeam"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="远光灯"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="环境光感阈值档位（实车可结合右侧遥测确认方向）："
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <RadioGroup
                        android:id="@+id/rgSensorThreshold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbLevel1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="L1"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbLevel2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="L2"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbLevel3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="L3"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbLevel4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="L4"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbLevel5"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="L5"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </RadioGroup>

                    <RadioGroup
                        android:id="@+id/rgSensorDirection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbSensorLte"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="&lt;= 阈值视为夜间"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbSensorGte"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=">= 阈值视为夜间"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="防抖延迟（防止进出短桥洞频繁切换）："
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <RadioGroup
                        android:id="@+id/rgDebounce"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbDebounce0"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0秒"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbDebounce1500"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1.5秒"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbDebounce3000"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="3秒"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbDebounce5000"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="5秒"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </RadioGroup>

                    <CheckBox
                        android:id="@+id/cbBootAutoStart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="车机开机 / 上电后自动启动后台监控服务"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- 右栏：实时硬件遥测 + 调试日志控制台 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.92"
            android:orientation="vertical">

            <!-- 上半部：实时硬件状态遥测 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="实时硬件信号遥测"
                        android:textColor="@color/accent_ocean"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnCheckPermissions"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:paddingHorizontal="10dp"
                        android:text="@string/btn_check_permissions"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnPollNow"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_btn_primary"
                        android:paddingHorizontal="12dp"
                        android:text="@string/btn_poll_now"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTelemetrySystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="monospace"
                    android:text="系统 uiMode：等待读取..."
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTelemetryLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="monospace"
                    android:text="车灯 BYDAutoLightDevice：等待初始化..."
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTelemetrySensor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="monospace"
                    android:text="光感 BYDAutoSensorDevice：等待初始化..."
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTelemetryBodywork"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="monospace"
                    android:text="电源 BYDAutoBodyworkDevice：等待初始化..."
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTelemetryDecision"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="触发判定：--"
                    android:textColor="@color/accent_teal"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 下半部：实时调试日志控制台 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="实时调试日志与堆栈"
                        android:textColor="@color/accent_ocean"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnSetLogPath"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_btn_primary"
                        android:paddingHorizontal="8dp"
                        android:text="@string/btn_set_log_path"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnCopyLogs"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:paddingHorizontal="8dp"
                        android:text="@string/btn_copy_logs"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnExportLogs"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:paddingHorizontal="8dp"
                        android:text="@string/btn_export_logs"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnClearLogs"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:paddingHorizontal="8dp"
                        android:text="@string/btn_clear_logs"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLogFilePath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="日志文件："
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <ScrollView
                    android:id="@+id/scrollLog"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_console"
                    android:padding="8dp"
                    android:scrollbars="vertical">

                    <TextView
                        android:id="@+id/tvLogConsole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#CBD5E1"
                        android:textIsSelectable="true"
                        android:textSize="11sp" />
                </ScrollView>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
